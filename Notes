/**
 * Callback handler for generic wlan-related commands
 * @param param string of further parameters
 * @return none
 */
void cbWlanCommand(String params){
    // param = [port] [on|off]

    // get the params split in two
//    int index = params.indexOf(" ");
    if(params == "reset"){
        resetWlanConfig();
        mqtt_log("WLAN config reset");
    }
}


/*******************************************************************************
 *******************************************************************************
 **
 ** WLAN SETUP / LOOP FUNCTIONS
 **
 *******************************************************************************
 ******************************************************************************/

/**
 * Setup function for the WLAN module - run
 * once, at boot time. Initialises the WLAN
 * interface, loads config (if it exists) and
 * does a first attempt to connect. If no config
 * is found, it initiates setup mode
 * @param none
 * @return boolean successful
 */
boolean setup_wlan(){

// Emergency to get default nw saved
//  saveConfig(0,"","");


  WiFi.softAPdisconnect(true);

  // Original  EEPROM based config
  //if ( restoreConfig()) {
  if (loadWlanConfig()) {

    WiFi.mode(WIFI_STA);
    //WiFi.hostname(string_buffer);
    //WiFi.begin(essid, password);

    unsigned int index;
    index = 0;  /* use config 0 */

    if(try_wlan_connection(index) == true){
      Serial.println("Associated to WLAN on first attempt");
      settingMode = false;
    }else{
      if(try_wlan_connection(!index) == true){
        Serial.println("Associated to WLAN on second attempt");
        settingMode = false;
      }else{
        // failed twice
        Serial.println("Association failed twice - starting Set-up Mode");
        settingMode = true;
      }
    }
  }else{
    // no configuration found (or parsable)
    // so need to invoke setup mode
    settingMode = true;
  }

  // If settingMode is flagged, enter setup mode
  if( settingMode == true){    
    setupMode();
    startWebServer();
  }

  // Disable this *second* call to start the website -- seems unneccessary (October 2024)
  //Serial.println("call to startWebServer");
  //startWebServer();

  // Register module commands
  commands->add("wlan", cbWlanCommand);

  Serial.println("Exiting setup_wlan");

  return(!settingMode);
}


void loop_wlan(){

  // 2023: Emergency rescue!!
  // resetWlanConfig();
  // Serial.println("emergency purge of wlanConfig");

  if(settingMode==true){
    dnsServer.processNextRequest();    
  }
#ifdef ENABLE_WEBSERVER
  webServer.handleClient();
#endif
}
